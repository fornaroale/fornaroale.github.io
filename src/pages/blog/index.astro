---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    const da = a.data.date ? new Date(a.data.date).valueOf() : 0;
    const db = b.data.date ? new Date(b.data.date).valueOf() : 0;
    return db - da;
  });

function formatDate(d?: Date) {
  if (!d) return "";
  return new Date(d).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}
---
<BaseLayout title="Blog">
  <div class="home">
    <h1 class="page-heading">Blog</h1>
    {posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <span class="post-meta">{formatDate(post.data.date)}</span>
            <h3>
              <a class="post-link" href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>
            {post.data.description && <p class="post-meta">{post.data.description}</p>}
          </li>
        ))}
      </ul>
    ) : (
      <p>No posts yet.</p>
    )}
  </div>
</BaseLayout>
